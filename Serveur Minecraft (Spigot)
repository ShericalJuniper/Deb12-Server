AJOUTER UN PACK DE TEXTURE :

    server.properties

    require-resource-pack=true

    resource-pack=lien_vers_telechargement_direct_du_zip_du_ressource_pack

    resource-pack-sha1=xxxxxxxxx (pour avoir le sha -> shasum -a 1 nom_du_pack.zip)



